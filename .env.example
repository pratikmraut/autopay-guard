# AutoPay Guard local-development configuration.
#
# Do not use this file as a credential source and do not put real credentials
# here. `make bootstrap` creates a gitignored `.env` with random, local-only
# values for every entry marked `generated`.

COMPOSE_PROJECT_NAME=autopay-guard
TZ=Asia/Kolkata

# Host ports are loopback-bound by compose.yaml.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8080
WEB_PORT=3000

# PostgreSQL application database.
POSTGRES_DB=autopay_guard
POSTGRES_USER=autopay_guard_admin
POSTGRES_PASSWORD=generated-by-make-bootstrap
APP_DB_USER=autopay_guard
APP_DB_PASSWORD=generated-by-make-bootstrap

# Dedicated Keycloak database.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=generated-by-make-bootstrap

# Development-only Keycloak administration and seeded fake identities.
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_USER_USERNAME=demo@autopayguard.local
KEYCLOAK_FAKE_USER_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_MEMBER_USERNAME=member@autopayguard.local
KEYCLOAK_FAKE_MEMBER_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_FOREIGN_USERNAME=foreign@autopayguard.local
KEYCLOAK_FAKE_FOREIGN_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_GUIDE_ADMIN_USERNAME=admin@autopayguard.local
KEYCLOAK_FAKE_GUIDE_ADMIN_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_PRIVACY_ADMIN_USERNAME=privacy-admin@autopayguard.local
KEYCLOAK_FAKE_PRIVACY_ADMIN_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_AUDIT_READ_USERNAME=audit-reader@autopayguard.local
KEYCLOAK_FAKE_AUDIT_READ_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_SUPPORT_USERNAME=support@autopayguard.local
KEYCLOAK_FAKE_SUPPORT_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_FAKE_DELETION_USERNAME=deletion@autopayguard.local
KEYCLOAK_FAKE_DELETION_PASSWORD=generated-by-make-bootstrap
KEYCLOAK_WEB_CLIENT_ID=autopay-guard-web
KEYCLOAK_WEB_CLIENT_SECRET=generated-by-make-bootstrap

# API configuration for processes launched directly on the host.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/autopay_guard
SPRING_DATASOURCE_USERNAME=autopay_guard
SPRING_DATASOURCE_PASSWORD=generated-by-make-bootstrap
IMPORT_FINGERPRINT_KEY=generated-by-make-bootstrap
OIDC_ISSUER_URI=http://localhost:8081/realms/autopay-guard
OIDC_AUDIENCE=autopay-guard-api
OIDC_AUTHORIZED_PARTY=autopay-guard-web
NOTIFICATION_EMAIL_MODE=MAILPIT
NOTIFICATION_FROM_ADDRESS=no-reply@autopayguard.local
NOTIFICATION_ALLOWED_RECIPIENT_SUFFIXES=@autopayguard.local,.example.test
NOTIFICATION_GENERATOR_CRON="0 */1 * * * *"
NOTIFICATION_WORKER_CRON="*/5 * * * * *"
NOTIFICATION_RECONCILIATION_CRON="0 */5 * * * *"

# Next.js/Auth.js configuration for processes launched directly on the host.
AUTOPAY_GUARD_RUNTIME_MODE=LOCAL
AUTH_SECRET=generated-by-make-bootstrap
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=autopay-guard-web
AUTH_KEYCLOAK_SECRET=generated-by-make-bootstrap
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/autopay-guard
AUTH_KEYCLOAK_INTERNAL_ISSUER=http://localhost:8081/realms/autopay-guard
API_BASE_URL=http://localhost:8080
# Production only: exact comma-separated HTTPS server egress origins.
API_OUTBOUND_ALLOWED_ORIGINS=
WEB_OUTBOUND_ALLOWED_ORIGINS=
